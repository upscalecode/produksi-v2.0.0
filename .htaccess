# Support hosting where the project itself is the document root.
Options -Indexes -MultiViews
RewriteEngine On

# Deny hidden files before forwarding requests to the public directory.
RewriteRule (^|/)\. - [F,L]

# Serve the home page directly, without relying on the hosting DirectoryIndex.
RewriteRule ^$ public/index.html [L]

# Requests already forwarded to public/ use that directory's routing rules.
RewriteRule ^public(?:/|$) - [L]
RewriteRule ^(.*)$ public/$1 [L]
